# ============================================================================
# FINsight 360 - Streamlit AI Copilot Environment Configuration Template
# Copy this file to .env in the app/ or root directory and fill in your keys.
# ============================================================================

# LLM API Keys (Provide at least one)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Optional: PostgreSQL Database Connection (Fallback to in-memory DuckDB/SQLite if not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=finsight360
PGUSER=postgres
PGPASSWORD=Spurthi@123

# Database Engine Selection ('duckdb', 'sqlite', or 'postgres')
DATABASE_ENGINE=duckdb
